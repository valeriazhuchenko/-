# Telegram
BOT_TOKEN=
WEBAPP_URL=https://your-project.vercel.app
WEBHOOK_URL=https://your-project.vercel.app/telegram/webhook

# Server
PORT=3000
NODE_ENV=production

# Локальная разработка в браузере (на Vercel не включать!)
DEV_SKIP_AUTH=true

# Firebase (опционально; без них данные в памяти — на Vercel не сохраняются!)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
